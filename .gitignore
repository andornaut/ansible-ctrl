.ansible/
__pycache__/

# Inventory and variables: these name hosts and bind credentials, so the whole
# directory is ignored rather than the files known to exist today.
hosts
group_vars/
host_vars/

# Secret material, encrypted or not: ciphertext is a standing offer to whoever later
# obtains the key. The generic patterns (*.sops.yml, *.key, .env) are in the global ignore
# file. The managed store lives in /etc/faramir/secrets, outside this checkout, so this
# entry guards against the directory reappearing.
secrets/

# Holds no value, only secret:// references, but those references map this
# repo's variables onto the secret store's layout.
faramir.env
