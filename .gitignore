.ansible/
.ruff_cache/
__pycache__/

# Inventory and variables: these name hosts and bind credentials, so the whole
# directory is ignored rather than the files known to exist today.
hosts
group_vars/
host_vars/

# Secret material, encrypted or not: ciphertext is a standing offer to whoever later
# obtains the key. The generic patterns (*.sops.yml, *.key, .env) are in the global ignore
# file. The managed store lives in ~/.config/faramir/secrets, outside this checkout, so
# this entry guards against the directory reappearing.
secrets/

# Holds no value, only credential names, but those names carry site names and
# this repository is public.
faramir.env

# AI agent instructions, local only. Named here as well as in the global
# ignore, which a session working from a fresh clone does not have.
AGENTS.md
CLAUDE.md
GEMINI.md

# Agent skills are repo knowledge and are committed; the rest of .claude/ is not.
# The global ignore excludes .claude/ wholesale, and git cannot re-include a file
# whose parent directory is excluded, so the directory is re-included first.
!.claude/
.claude/*
!.claude/skills/
