#!/usr/bin/env bash
# Free up disk space. Requires root. Run weekly via /etc/cron.d/ansible-role-base.
set -euo pipefail
# Each step's stdout is parsed into one summary line, so its messages must not be translated.
export LC_ALL=C

# Run an apt command, waiting out another apt process rather than giving up on
# it. apt-get exits 100 immediately when it cannot take the lock, and
# DPkg::Lock::Timeout does not cover the archives lock `clean` takes, so the
# waiting has to happen here. Any other status is a failure retrying will not
# clear, and is reported at once.
apt_wait() {
    local attempt=1 rc=0
    while true; do
        # Taken from the command itself: after an `if`, $? is the status of the
        # `if`, which is 0 whenever its condition merely failed.
        rc=0
        "$@" || rc=$?
        if [[ ${rc} -eq 0 ]]; then
            return 0
        fi
        if [[ ${rc} -ne 100 || ${attempt} -ge 5 ]]; then
            echo "disk-cleanup: ${*} failed (rc=${rc})" >&2
            return "${rc}"
        fi
        attempt=$((attempt + 1))
        sleep 60
    done
}

# Remove the downloaded .deb package cache. The apt steps do not stop the rest:
# each cleanup below frees space of its own, and apt being busy is no reason to
# skip them for a week.
apt_wait apt-get clean || true

# Remove orphaned packages and old kernels, purging their config. The package list is the part
# of the summary worth reading: autoremove takes whatever nothing depends on any more.
out=$(apt_wait apt-get autoremove --purge --yes) || true
packages=$(sed -n 's/^Removing \([^ :]*\).*/\1/p' <<<"${out}" | paste -sd' ')
if [[ -n ${packages} ]]; then
    freed=$(sed -n 's/^After this operation, \(.*\) disk space will be freed\.$/\1/p' <<<"${out}")
    echo "apt autoremove: $(wc -w <<<"${packages}") packages, ${freed}: ${packages}"
else
    echo "apt autoremove: nothing to remove"
fi

# Vacuum journald logs (also enforced continuously by journald.conf). journalctl reports on
# stderr, one line per journal directory: those are summed, anything else is passed through.
freed=$(journalctl --vacuum-size=500M --vacuum-time=4weeks 2>&1 | awk '
    /^Deleted archived journal / { next }
    /^Vacuuming done, freed / {
        n = $4 + 0
        u = substr($4, length($4))
        if (u == "K") n *= 1024
        else if (u == "M") n *= 1024 ^ 2
        else if (u == "G") n *= 1024 ^ 3
        else if (u == "T") n *= 1024 ^ 4
        total += n
        next
    }
    { print > "/dev/stderr" }
    END { printf "%d\n", total }
') || true
echo "journal: $(numfmt --to=iec --suffix=B "${freed:-0}")"

# Rotated and compressed logs. logrotate keeps these for its own retention window, which is
# time the disk pays for; the live files it is still writing are untouched.
find /var/log -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -delete || true

# Unused images, networks and build cache. Containers and volumes are preserved: a stopped
# container may be one taken down on purpose and still be wanted.
# The binary existing does not mean the daemon is up, and a prune against a stopped dockerd
# fails: guarded so it cannot take the flatpak and thumbnail sweeps down with it.
if command -v docker >/dev/null 2>&1; then
    out=$(docker image prune --all --force) || true
    echo "docker images: $(sed -n 's/^Total reclaimed space: //p' <<<"${out}")"
    out=$(docker builder prune --force) || true
    echo "docker build cache: $(sed -n 's/^Total:[[:space:]]*//p' <<<"${out}")"
    out=$(docker network prune --force) || true
    networks=$(awk 'f && NF; /^Deleted Networks:$/ { f = 1 }' <<<"${out}" | paste -sd' ')
    echo "docker networks: $(wc -w <<<"${networks}")${networks:+ (${networks})}"
fi

# Uninstall runtimes no installation references and report the refs that went. The listing is
# compared before and after rather than parsed from uninstall's output, whose layout is for a
# terminal. Arguments are the command prefix that runs flatpak against one installation.
flatpak_unused() {
    local label=$1 before after removed
    shift
    before=$("$@" flatpak list --columns=ref </dev/null | sort) || true
    # Guarded so that a failure against one installation does not skip the rest: the per-user
    # ones hold the space, and are reached after the system one.
    "$@" flatpak uninstall --unused --assumeyes </dev/null >/dev/null || true
    after=$("$@" flatpak list --columns=ref </dev/null | sort) || true
    removed=$(comm -23 <(echo "${before}") <(echo "${after}") | paste -sd' ')
    echo "flatpak (${label}): ${removed:-nothing unused}"
}

# Remove flatpak runtimes and extensions no longer referenced by any app.
#
# `--unused` acts on the installation of whoever runs it, so this root run
# reaches the system one and nothing else. On a desktop the runtimes are almost
# entirely in the per-user installations under $HOME/.local/share/flatpak, so
# each account that has one is passed over separately.
#
# The accounts are discovered rather than passed in: which ones own flatpaks is
# decided by the desktop, games and hobbies roles, and this script belongs to
# base, which does not read their variables.
if command -v flatpak >/dev/null 2>&1; then
    flatpak_unused system

    while IFS=: read -r name _ uid _ _ home _; do
        [[ ${uid} -ge 1000 && ${uid} -lt 65534 ]] || continue
        [[ -d ${home}/.local/share/flatpak ]] || continue
        # HOME is named because runuser does not set it, and flatpak reads it
        # to find the installation: unset, it would act on root's again.
        # stdin is redirected inside flatpak_unused because the loop reads from getent: a child
        # that read it would swallow passwd lines and silently skip the accounts after this one.
        flatpak_unused "${name}" runuser -u "${name}" -- env HOME="${home}"
    done < <(getent passwd)
fi

# Thumbnail caches, which every file manager regenerates on demand. Per-user, for the same
# reason the flatpak sweep above is: each account has its own under $HOME.
#
# The path is owned by the account, so it can point anywhere. The deletion runs as the account
# rather than as root, so a symlink leads it nowhere the account could not already delete, and
# a symlinked cache directory is skipped outright. stdin is redirected as in the flatpak loop.
while IFS=: read -r name _ uid _ _ home _; do
    [[ ${uid} -ge 1000 && ${uid} -lt 65534 ]] || continue
    [[ -L ${home}/.cache/thumbnails ]] && continue
    [[ -d ${home}/.cache/thumbnails ]] || continue
    runuser -u "${name}" -- \
        find "${home:?}/.cache/thumbnails" -mindepth 1 -delete </dev/null 2>/dev/null || true
done < <(getent passwd)
