# Managed by the base role. jail.conf is replaced on upgrade; this file is not.
[DEFAULT]
# The journal, not /var/log/auth.log, which exists only while rsyslog does. Without it a
# jail reads nothing and still reports healthy.
backend = systemd
bantime = {{ base_fail2ban_bantime }}
findtime = {{ base_fail2ban_findtime }}
maxretry = {{ base_fail2ban_maxretry }}
ignoreip = {{ base_fail2ban_ignore_ips | join(' ') }}

[sshd]
enabled = true
# What the ban rule filters, so it has to be the port sshd listens on.
port = {{ base_lockdown_ssh_port }}
