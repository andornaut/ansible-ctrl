# Managed by Ansible (desktop role). Do not edit.
# Per-node property overrides for hardware that misbehaves under WirePlumber's defaults: a
# format it advertises but cannot sustain, or a stream it fails to recover from closing.
# Set here rather than by a card profile, which whatever the user last picked in a
# volume-control UI overrides.
monitor.alsa.rules = [
{% for node, props in desktop_wireplumber_node_properties.items() %}
  {
    matches = [
      {
        node.name = "{{ node }}"
      }
    ]
    actions = {
      update-props = {
{% for key, value in props.items() %}
        {{ key }} = {{ value | to_json }}
{% endfor %}
      }
    }
  }{{ "," if not loop.last }}
{% endfor %}
]
