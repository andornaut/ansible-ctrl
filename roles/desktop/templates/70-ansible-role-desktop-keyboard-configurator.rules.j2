# Managed by Ansible (desktop role). Do not edit.
# The raw HID interface a keyboard configurator talks to, and nothing else of the keyboard:
# its boot keyboard and mouse interfaces (USB interface protocol 01 and 02) stay root-only.
# A grant on those lets a game's Wine open the keyboard as a HID device and read keys from
# its reports, below the kernel keymap and every XKB remap. The vendor is matched by udev
# property rather than sysfs attribute, the protocol living on the interface and the vendor
# on the device, which one ATTRS group cannot span.
{% for dev in desktop_keyboard_configurator_ids %}
SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="{{ dev.vendor }}"{% if dev.product is defined %}, ENV{ID_MODEL_ID}=="{{ dev.product }}"{% endif %}, ATTRS{bInterfaceProtocol}=="00", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="{{ dev.vendor }}"{% if dev.product is defined %}, ATTR{idProduct}=="{{ dev.product }}"{% endif %}, ENV{ID_MM_DEVICE_IGNORE}="1"
{% endfor %}
{% for dev in desktop_keyboard_configurator_bootloader_ids %}
SUBSYSTEM=="usb", ATTR{idVendor}=="{{ dev.vendor }}", ATTR{idProduct}=="{{ dev.product }}", TAG+="uaccess"
{% endfor %}
