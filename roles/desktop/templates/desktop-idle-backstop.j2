#!/usr/bin/env bash
# {{ ansible_managed }}
#
# The floor under the session's blanking policy. GNOME, xss-lock and hypridle each honour
# an idle inhibitor for as long as an application holds one, and none of them caps how
# long that may be, so a game left running keeps a static image on the panel indefinitely.
# This reads an idle time no inhibitor can freeze and powers the panel down from outside
# the compositor once it passes the threshold.
set -euo pipefail

readonly MECHANISM={{ desktop_idle_backstop_mechanism }}
readonly THRESHOLD_MS={{ desktop_idle_backstop_milliseconds }}
# Coarse while the panel is lit, nothing waiting on the answer. Fine once it is dark: this
# is what turns the panel back on, and that latency is felt at the keyboard.
readonly POLL_LIT_SECONDS=30
readonly POLL_DARK_SECONDS=2
# Consecutive failed idle reads before this exits for systemd to start it again. A unit
# started outside a graphical session has no display and no session bus to read, and the
# import that fixes that reaches the user manager rather than an already-running service,
# so exiting is what picks the session up. Restarting is also the only signal that a
# backstop is not backstopping anything.
readonly MAX_READ_FAILURES=3
# Wake attempts before giving up on a panel that will not answer, so a monitor that has
# gone unreachable is not written to every two seconds for the rest of the session.
readonly MAX_WAKE_ATTEMPTS=15

dark=false
read_failures=0
wake_attempts=0

log() {
    printf '%s\n' "$*" >&2
}

# Milliseconds since the last real input.
idle_ms() {
    case "${MECHANISM}" in
    ddc)
        # mutter's idle monitor counts input, not policy: an inhibitor is honoured in
        # gnome-session and leaves this climbing. GNOME is Wayland-only, so there is no X
        # server to ask instead.
        busctl --user call org.gnome.Mutter.IdleMonitor /org/gnome/Mutter/IdleMonitor/Core \
            org.gnome.Mutter.IdleMonitor GetIdletime | awk '{print $2}'
        ;;
    xset)
        # XScreenSaverQueryInfo counts input too. XScreenSaverSuspend, which is what an
        # X11 application holds to keep the screen alive, stops the screensaver activating
        # without freezing this counter.
        xprintidle
        ;;
    niri)
        # niri exposes no idle time of its own, only ext-idle-notify-v1, which it gates on
        # the inhibitors this has to see past. The stamp is what desktop-idle-input reads
        # off the input devices instead: last input, then a heartbeat. A stale heartbeat
        # means that reader died and the first number is frozen, which would read as a
        # session going idle, so it is refused rather than believed.
        local last beat now
        read -r last beat <{{ desktop_idle_input_stamp }} || return 1
        now=$(printf '%(%s)T' -1)
        ((now - beat <= {{ desktop_idle_input_stale_seconds }})) || return 1
        echo $(((now - last) * 1000))
        ;;
    esac
}

power_off() {
    case "${MECHANISM}" in
    # Nothing outside a Wayland compositor can reach DPMS, so this addresses the monitor
    # itself over DDC/CI. 04 is DPM off, and the panel keeps answering the bus there,
    # which is what makes power_on reversible without the monitor's own power button.
    ddc) ddcutil setvcp d6 04 ;;
    # Explicit, so it lands whatever the screensaver has been told to do.
    xset) xset dpms force off ;;
    # niri's own action, which the hypridle template already uses for its power-off listener.
    niri) niri msg action power-off-monitors ;;
    esac
}

power_on() {
    case "${MECHANISM}" in
    ddc) ddcutil setvcp d6 01 ;;
    # The X server restores the display on the next input by itself.
    xset) : ;;
    niri) niri msg action power-on-monitors ;;
    esac
}

# A monitor left in DDC standby outlives the session and greets the next login looking
# dead, so the panel comes back up before this exits however it is stopped.
finish() {
    local code=${1:-0}
    trap - EXIT INT TERM
    if [[ ${dark} == true ]]; then
        power_on || log "could not power the display back up"
    fi
    exit "${code}"
}

trap 'finish 0' EXIT INT TERM

while true; do
    if ! idle=$(idle_ms 2>/dev/null) || [[ ! ${idle} =~ ^[0-9]+$ ]]; then
        read_failures=$((read_failures + 1))
        log "could not read the idle time (${read_failures}/${MAX_READ_FAILURES})"
        if ((read_failures >= MAX_READ_FAILURES)); then
            log "exiting, so the restart reads the session environment as it stands now"
            finish 1
        fi
    elif ((idle >= THRESHOLD_MS)); then
        read_failures=0
        # dark is set whether or not the write landed: a panel that has already gone dark
        # on its own may stop answering the bus, and retrying every poll would say so for
        # as long as nobody touches the keyboard. ddcutil retries the write itself.
        if [[ ${dark} == false ]]; then
            log "idle for ${idle}ms, powering the display down"
            power_off || log "could not power the display down"
            dark=true
            wake_attempts=0
        fi
    else
        read_failures=0
        # dark is held until the panel is confirmed back, so a write that does not land
        # is retried on the next poll rather than leaving a dark screen in front of
        # someone who is typing. Bounded, so an unreachable panel is eventually let go.
        if [[ ${dark} == true ]]; then
            wake_attempts=$((wake_attempts + 1))
            if power_on; then
                log "input after ${idle}ms, display powered back up"
                dark=false
            elif ((wake_attempts >= MAX_WAKE_ATTEMPTS)); then
                log "could not power the display back up in ${wake_attempts} attempts, giving up"
                dark=false
            else
                log "could not power the display back up, retrying"
            fi
        fi
    fi

    if [[ ${dark} == true ]]; then
        sleep "${POLL_DARK_SECONDS}" &
    else
        sleep "${POLL_LIT_SECONDS}" &
    fi
    # Backgrounded, so a stop is acted on at once rather than at the end of the interval,
    # and so bash does not report the killed sleep to the journal on every restart.
    wait "$!" || true
done
