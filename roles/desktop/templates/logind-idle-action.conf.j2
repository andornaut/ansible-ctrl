# Managed by the desktop role (tasks/idle.yml); edits are lost on the next run. Policy
# comes from desktop_suspend_inactive_minutes.
#
# logind cannot detect idleness itself: xss-lock sets the idle hint at blank time and
# IdleActionSec counts from there, so the role subtracts the blank timeout. System-wide,
# unlike the GNOME and niri mechanisms, so every session must be idle, ssh included.
# IdleAction=ignore takes no timeout. See the role README.
[Login]
IdleAction={{ desktop_suspend_idle_action }}
{% if desktop_suspend_idle_action == 'suspend' %}
IdleActionSec={{ desktop_suspend_idle_action_seconds }}
{% endif %}
