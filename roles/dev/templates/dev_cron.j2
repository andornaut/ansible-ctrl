# Ansible managed - dev role cron entries

# System PATH plus the directories the role's cron scripts live in. Not for cron, which
# runs both by absolute path, but for what those scripts then invoke: the agent command
# ai-maintainer is given by name resolves here. The two directories are the same wherever
# neither path is overridden, hence the unique.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:{{
  [dev_ai_attributions_binary_path | dirname,
   dev_ai_maintainer_script_path | dirname] | unique | join(':') }}

{% if dev_install_ai_attributions %}
# ai-attributions: daily attribution scan. The checkouts are listed by find
# rather than by a glob, so a directory under the base that is not a repository
# is passed over instead of failing the run. Command substitution rather than
# xargs, which reports its own status in place of the scan's for anything that
# adds --exit-code to the flags.
{{ dev_ai_attributions_cron_minute }} {{ dev_ai_attributions_cron_hour }} * * * {{ dev_user }} {{ dev_ai_attributions_binary_path }} scan {{ dev_ai_attributions_scan_flags }} $(find {{ dev_ai_attributions_src_base_dir }} -mindepth 2 -maxdepth 2 -name .git -exec dirname {} +{% if dev_ai_attributions_exclude_repositories %} | grep -vxF{% for repo in dev_ai_attributions_exclude_repositories %} -e {{ dev_ai_attributions_src_base_dir }}/{{ repo }}{% endfor %}{% endif %})
{% endif %}
{% if dev_install_ai_maintainer %}
# ai-maintainer: weekly repo maintenance
{{ dev_ai_maintainer_cron_minute }} {{ dev_ai_maintainer_cron_hour }} {{ dev_ai_maintainer_cron_day }} * {{ dev_ai_maintainer_cron_weekday }} {{ dev_user }} {{ dev_ai_maintainer_script_path }} {{ dev_ai_maintainer_script_args }} --base-dir {{ dev_ai_maintainer_src_base_dir | dirname }} --agent-command {{ dev_ai_maintainer_agent_command }} --agent-flags="{{ dev_ai_maintainer_agent_flags }}" --dependency-min-age-days {{ dev_ai_maintainer_dependency_min_age_days }}{% for repo in dev_ai_maintainer_exclude_repositories %} -e {{ repo }}{% endfor %}

{% endif %}