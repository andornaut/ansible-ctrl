# {{ ansible_managed }}
[Unit]
Description=Periodically refresh Heroic (Epic/GOG) store login tokens

[Timer]
# Without linger the user manager starts at login, so OnStartupSec is the catch-up run
# and OnUnitActiveSec carries a long session.
OnStartupSec=1min
OnUnitActiveSec={{ games_heroic_token_refresh_interval }}

[Install]
WantedBy=timers.target
