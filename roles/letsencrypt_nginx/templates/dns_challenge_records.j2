{#- One TXT record per name each pending DNS-01 order covers, with the site it belongs to. -#}
{% set records = [] %}
{% for result in letsencrypt_nginx_challenge.results
   if result is not skipped and result.changed and result.challenge_data
   and result.item.cloudflare_api_token is defined
   and not result.item.use_selfsigned_certificate | default(false) %}
{% for record, values in result.challenge_data_dns.items() %}
{% set _ = records.append({'record': record, 'value': values | first, 'site': result.item}) %}
{% endfor %}
{% endfor %}
{{ records | to_json }}
