{#- One token file per name each pending HTTP-01 order covers. Each site's port-80 server
    answers for <domain> and www.<domain> out of /var/www/<domain>, so a www name's token is
    served from its site's root. -#}
{% set resources = [] %}
{% for result in letsencrypt_nginx_challenge.results
   if result is not skipped and result.changed and result.challenge_data
   and result.item.cloudflare_api_token is not defined
   and not result.item.use_selfsigned_certificate | default(false) %}
{% for name, challenges in result.challenge_data.items() %}
{% set _ = resources.append({'name': name,
                             'root': name | regex_replace('^www\\.', ''),
                             'resource': challenges['http-01']['resource'],
                             'value': challenges['http-01']['resource_value']}) %}
{% endfor %}
{% endfor %}
{{ resources | to_json }}
