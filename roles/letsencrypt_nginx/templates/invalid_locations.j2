{#- One line per entry of a site's locations that would misbehave: an alias whose src and dest
    disagree on the trailing slash serves /<src>../ from outside dest, and credentials naming a
    file_basename that no alias declares and no site with credentials is called answer 500
    instead of prompting. A location at / replaces the site's own, so on a proxied site it drops
    the proxy. -#}
{% set basenames = (letsencrypt_nginx_websites | selectattr('aliases', 'defined') | map(attribute='aliases')
   | flatten | selectattr('file_basename', 'defined') | map(attribute='file_basename') | list)
   + (letsencrypt_nginx_websites | selectattr('credentials', 'defined') | selectattr('credentials')
   | map(attribute='domain') | list) %}
{% set problems = [] %}
{% for site in letsencrypt_nginx_websites %}
{% for location in site.locations | default([]) %}
{% if (location.src | string).endswith('/') != (location.dest | string).endswith('/') %}
{% set _ = problems.append(site.domain ~ ' ' ~ location.src ~ ': src and dest must both end in / or neither') %}
{% endif %}
{% if location.src == '/' and site.proxy_port is defined %}
{% set _ = problems.append(site.domain ~ ' /: a location at / replaces the proxy, so the site can have no proxy_port') %}
{% endif %}
{% if location.credentials | default(false)
   and location.credentials.file_basename | default('') not in basenames %}
{% set _ = problems.append(site.domain ~ ' ' ~ location.src ~ ': credentials.file_basename "'
   ~ location.credentials.file_basename | default('') ~ '" names no alias and no site with credentials') %}
{% endif %}
{% endfor %}
{% endfor %}
{{ problems | to_json }}
