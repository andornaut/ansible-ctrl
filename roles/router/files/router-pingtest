#!/bin/sh
# Managed by Ansible (router role). Do not edit.
#
# Bounces an interface when every target is unreachable, for a link that comes back only
# after a reset.
#
# The targets are addresses rather than names on purpose: a name cannot tell a dead link
# from a resolver that stopped answering, and bouncing the WAN over the latter takes the
# link down for a minute and fixes nothing. The resolver is router-dns-healthcheck's.
#
# It does not reboot. A reset that did not restore the link twice running is a fault a
# reboot does not address, and rebooting is how a router with a flapping upstream ends up
# in a boot loop that outlasts the outage.

# cron gives a job a minimal PATH, and this reaches binaries in four directories.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

set -u

NAME="$(basename "$0")"

[ "$#" -ge 4 ] \
    || { echo "Usage: ${NAME} <interface> <downSeconds> <settleSeconds> <target>..." >&2; exit 1; }

interface=${1}
down_seconds=${2}
settle_seconds=${3}
shift 3

log() { logger -t "${NAME}" -p daemon.notice "$*"; }
warn() { logger -t "${NAME}" -p daemon.err "$*"; }

# Exits on the first target that answers: this asks whether the link carries traffic at
# all, so one reachable address settles it.
any_target_answers() {
    for target in "$@"; do
        if ping -c 1 -t 5 "${target}" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

any_target_answers "$@" && exit 0

warn "no reply from $*, resetting ${interface}"
/sbin/ifconfig "${interface}" down
sleep "${down_seconds}"
/sbin/ifconfig "${interface}" up

# A PPPoE WAN has to redial before anything routes, and the redial starts only once the
# parent interface is up.
sleep "${settle_seconds}"

if any_target_answers "$@"; then
    log "link restored after resetting ${interface}"
    exit 0
fi

warn "no reply from $* after resetting ${interface}, giving up"
exit 1
