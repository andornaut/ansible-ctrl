# rsnapshot.conf - managed by ansible-role-rsnapshot.
# Fields are tab-separated; backup directories require a trailing slash.

config_version	1.2

snapshot_root	{{ rsnapshot_directory }}
# The role creates snapshot_root. rsnapshot must not: a root missing because its filesystem is
# not mounted would otherwise be created on the filesystem beneath the mountpoint.
no_create_root	1

# System binaries for cp/rm (extra features, faster than the built-in perl routines).
cmd_cp		/bin/cp
cmd_rm		/bin/rm
cmd_rsync	/usr/bin/rsync
cmd_ssh		/usr/bin/ssh
cmd_logger	/usr/bin/logger
{% if rsnapshot_required_mountpoints %}
# Aborts the run when a required filesystem is missing, rather than snapshotting the
# empty directory an unmounted path reads as.
cmd_preexec	{{ rsnapshot_preexec_script }}
{% endif %}

# Retention intervals, ascending order. A null or zero value omits the line and its cron job.
{% for interval in ['hourly', 'daily', 'weekly', 'monthly'] if rsnapshot_retention[interval] %}
retain	{{ interval }}	{{ rsnapshot_retention[interval] }}
{% endfor %}

verbose		2
loglevel	3
logfile	/var/log/rsnapshot.log
lockfile	/var/run/rsnapshot.pid

{% set rsync_long_args_plain = '--delete --numeric-ids --relative --delete-excluded' %}
{% set rsync_long_args_sudo = rsync_long_args_plain ~ " --rsync-path='sudo /usr/bin/rsync'" %}
rsync_short_args	-az
# The fleet norm: a login that is not root, escalating to read what it cannot. A point that
# needs otherwise restates this in its own 4th field, which replaces this line rather than
# adding to it. Named rather than left implicit so that such a point has something to restate.
rsync_long_args	{{ rsync_long_args_sudo }}

# Backup points: directories pulled per host, then backup_script output. Login, locality,
# escalation and exclude quoting are described in the rsnapshot role README.
{% for host in rsnapshot_hosts %}
{% set is_local = host.host == inventory_hostname %}
{% set host_inventory_vars = hostvars[host.host] %}
{% set host_login = host.user | default(host_inventory_vars.ansible_user | default(primary_user)) %}
{% set host_sudo = not is_local and host_login != 'root' %}
{% for directory in host.directories | default((), true) %}
{% set path = directory.path if directory is mapping else directory %}
{% set excludes = directory.exclude | default([], true) if directory is mapping else [] %}
{% set long_args_option = ['rsync_long_args=' ~ rsync_long_args_plain] if not is_local and not host_sudo else [] %}
{% set point_options = long_args_option + excludes | map('regex_replace', '^(.*)$', 'exclude="\\1"') | list %}
{% set point_field = ('\t' ~ point_options | join(',')) if point_options else '' %}
backup	{% if not is_local %}{{ host_login }}@{{ host.name }}:{% endif %}{{ path }}	{{ host.name }}/{{ point_field }}
{% endfor %}
{% for script in host.scripts | default((), true) %}
backup_script	{{ script.command }} {{ script.args | default('') }}	{{ host.name }}_{{ script.command|basename }}/
{% endfor %}
{% endfor %}
