#!/bin/bash

set -euo pipefail

QUIET=false
# A .torrent file this new may still be being written. Uploading a truncated one
# gives the remote watch directory a file rtorrent cannot load, and a successful
# scp deletes the local copy, so nothing would be left to retry from.
MIN_AGE_SECONDS=30
# Bound a stalled transfer: the run holds a lock for its whole duration, so a hang
# blocks every later cron run. Without ConnectTimeout ssh waits out the kernel's TCP
# connect timeout, which is longer than the interval cron fires at, and once a
# transfer is under way only TCPKeepAlive notices a dead peer, after ~2 hours.
SSH_OPTS=(-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Upload .torrent files from local watch directories to the remote
host's watch directory via scp.

Files modified in the last ${MIN_AGE_SECONDS} seconds are left for the next run.

Options:
  -h, --help    Show this help message and exit
  -q, --quiet   Suppress output
EOF
    exit 0
}

# ANSI escapes only when the stream is a terminal: under cron this output goes to
# a log file or a mail spool, where the codes are noise. Stdout and stderr are
# tested separately because cron redirects them independently.
O_BOLD="" O_BLUE="" O_GREEN="" O_OFF="" E_RED="" E_YELLOW="" E_OFF=""
[[ -t 1 ]] && { O_BOLD=$'\033[1m'; O_BLUE=$'\033[1;34m'; O_GREEN=$'\033[1;32m'; O_OFF=$'\033[0m'; }
[[ -t 2 ]] && { E_RED=$'\033[1;31m'; E_YELLOW=$'\033[1;33m'; E_OFF=$'\033[0m'; }

error() { printf ' %s✗%s  %s\n' "${E_RED}" "${E_OFF}" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage ;;
        -q|--quiet) QUIET=true; shift ;;
        # Split a bundled short group (-hq) into -h -q and reprocess. Matches a
        # single dash followed by 2+ characters, so long options never reach it.
        # Do not rewrite this using bash's parameter-length syntax: that opens a
        # Jinja2 comment, and the template then fails to render.
        -[!-]?*)
            mapfile -t bundle < <(fold -w1 <<<"${1#-}")
            shift
            set -- "${bundle[@]/#/-}" "$@"
            ;;
        # This script takes no positional arguments, so an unrecognized flag
        # would otherwise be accepted and ignored.
        -*) error "unknown option: $1" ;;
        *) break ;;
    esac
done

header() { "${QUIET}" || printf '\n%s%s%s\n\n' "${O_BOLD}" "$*" "${O_OFF}"; }
info() { "${QUIET}" || printf ' %s•%s  %s\n' "${O_BLUE}" "${O_OFF}" "$*"; }
# shellcheck disable=SC2120  # ok() is intentionally called with no args (defaults to "OK")
ok() { "${QUIET}" || printf ' %s✔%s  %s\n' "${O_GREEN}" "${O_OFF}" "${*-OK}"; }
# Not gated on --quiet, unlike the others: a warning names what went wrong, and the
# cron job passes --quiet, so gating it leaves the final error unexplained in the log.
warn() { printf ' %s!%s  %s\n' "${E_YELLOW}" "${E_OFF}" "$*" >&2; }

# Returns non-zero if any file in the source directory could not be uploaded.
upload_torrent_files() {
    local src="${1}"
    local dst="${2}"
    # Under `set -e` a failing `cd` would abandon the remaining watch directories.
    [[ -d "${src}" ]] || { info "Skipping ${src}: not a directory"; return 0; }
    # Subshell: whatever happens below, the cd cannot leak back to the caller.
    (
        cd "${src}"
        local rc=0
        local -a scp_opts=("${SSH_OPTS[@]}")
        "${QUIET}" && scp_opts+=(-q)
        for f in *.torrent; do
            [[ -f "${f}" ]] || continue
            if (( $(date +%s) - $(stat -c %Y -- "${f}") < MIN_AGE_SECONDS )); then
                info "Skipping ${f}: modified in the last ${MIN_AGE_SECONDS}s"
                continue
            fi
            info "Copying ${f} to ${dst}"
            # ./ prefix on both: a name beginning with a dash is otherwise read as
            # an option, and the glob does not produce one. An unremoved file is
            # uploaded again on the next run, and to every remaining host in this one.
            if scp "${scp_opts[@]}" "./${f}" "${dst}"; then
                rm "./${f}" || rc=1
            else
                # Keep the file so the next run retries it. A failing scp is not
                # fatal on its own: the remaining files and watch directories are
                # still worth trying, and the caller reports the failure at the end.
                warn "Failed to copy ${f} to ${dst}"
                rc=1
            fi
        done
        exit "${rc}"
    )
}

header "Uploading .torrent files to remote watch directories"

failed=false
# One lock for the whole run: cron fires every 2 minutes, which is tighter than a
# stalled scp, and two overlapping runs race to rm the same file. flock holds the
# lock for the guarded subshell and releases it however that subshell ends,
# including a kill, which a pid check cannot see. The uid keeps the path from
# colliding with another user's lock file.
lock_file="${TMPDIR:-/tmp}/mvt-$(id -u).lock"
(
    # A held lock means a prior run is wedged, not that runs overlap normally: an
    # upload takes seconds and cron fires every 2 minutes. Fail so cron reports it.
    flock -n 9 || error "A previous upload is still running"
    upload_failed=false
    # The remote watch directory is derived from each host's own root: a delegated
    # task resolves plain variables from the play host, so the role's
    # torrent_watch_directory would name this host's path for every host.
{% for host in ansible_play_batch %}
{% if host != "localhost" %}
{% for watch_dir in torrent_local_watch_directories %}
    upload_torrent_files "{{ watch_dir }}" "{{ host }}:{{ hostvars[host].torrent_root_directory | default(torrent_root_directory) }}/watch/" || upload_failed=true
{% endfor %}
{% endif %}
{% endfor %}
    "${upload_failed}" && exit 1
    exit 0
) 9>"${lock_file}" || failed=true

# Exit non-zero so cron reports the run, which a per-file warning alone would not.
"${failed}" && error "Some .torrent files could not be uploaded"
ok
