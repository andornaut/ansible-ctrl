#!/bin/bash

set -euo pipefail

# A newer file may still be being written, and scp deletes the local copy on
# success, so a truncated upload leaves nothing to retry from.
MIN_AGE_SECONDS=30

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Upload .torrent files from local watch directories to the remote
host's watch directory via scp.

Files modified in the last ${MIN_AGE_SECONDS} seconds are left for the next run.

Options:
  -h, --help    Show this help message and exit
  -q, --quiet   Suppress output
EOF
    exit 0
}

{% include '_preamble.sh.j2' %}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage ;;
        -q|--quiet) QUIET=true; shift ;;
        # No positional arguments, so an unknown flag would be silently ignored.
        -*) error "unknown option: $1" ;;
        *) break ;;
    esac
done

# Returns non-zero if any file in the source directory could not be uploaded.
upload_torrent_files() {
    local src="${1}"
    local dst="${2}"
    local remote="${3}"
    local port="${4}"
    # Under `set -e` a failing cd would abandon the remaining watch directories.
    [[ -d "${src}" ]] || { info "Skipping ${src}: not a directory"; return 0; }
    # Subshell: whatever happens below, the cd cannot leak back to the caller.
    (
        cd "${src}"
        local rc=0
        local -a scp_opts=("${SSH_OPTS[@]}" -P "${port}")
        "${QUIET}" && scp_opts+=(-q)
        for f in *.torrent; do
            [[ -f "${f}" ]] || continue
            if (( $(date +%s) - $(stat -c %Y -- "${f}") < MIN_AGE_SECONDS )); then
                info "Skipping ${f}: modified in the last ${MIN_AGE_SECONDS}s"
                continue
            fi
            info "Copying ${f} to ${dst}"
            # ./ on both: a name beginning with a dash reads as an option, and
            # the glob does not produce one.
            if scp "${scp_opts[@]}" "./${f}" "${remote}:${dst#*:}"; then
                rm "./${f}" || rc=1
            else
                # Kept, so the next run retries it. Not fatal on its own: the
                # caller reports the failure at the end.
                warn "Failed to copy ${f} to ${dst}"
                rc=1
            fi
        done
        exit "${rc}"
    )
}

header "Uploading .torrent files to remote watch directories"

failed=false
# One lock for the whole run: cron fires every 2 minutes, tighter than a stalled scp, and
# two runs would race to rm the same file. flock releases however the guarded subshell
# ends, including a kill, which a pid check cannot see.
# In the user's home, not /tmp: fs.protected_regular refuses to open a lock file another
# user created there first. Not XDG_RUNTIME_DIR either, which cron does not set, so a
# manual run and the cron run would take different locks.
lock_dir="${HOME}/.cache"
mkdir -p "${lock_dir}"
lock_file="${lock_dir}/mvt.lock"
(
    # A held lock means a prior run is wedged, an upload taking seconds.
    flock -n 9 || error "A previous upload is still running"
    upload_failed=false
    # Derived from each host's own root: torrent_watch_directory belongs to the play that
    # configures one rtorrent host, and would name that host's path for every host here.
{% for host in groups['torrent'] | default([]) %}
{% for watch_dir in torrent_local_watch_directories %}
    upload_torrent_files "{{ watch_dir }}" "{{ host }}:{{ hostvars[host].torrent_root_directory }}/watch/" "{{ hostvars[host].ansible_user }}@{{ hostvars[host].ansible_host | default(host) }}" "{{ hostvars[host].ansible_port | default(22) }}" || upload_failed=true
{% endfor %}
{% endfor %}
    "${upload_failed}" && exit 1
    exit 0
) 9>"${lock_file}" || failed=true

# Non-zero so cron reports the run, which a per-file warning alone would not.
"${failed}" && error "Some .torrent files could not be uploaded"
ok
