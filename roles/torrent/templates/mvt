#!/bin/bash

set -euo pipefail

QUIET=false
# A newer file may still be being written, and scp deletes the local copy on
# success, so a truncated upload leaves nothing to retry from.
MIN_AGE_SECONDS=30
# Bound a stall: the run holds a lock throughout, so a hang blocks every later cron run.
# ssh otherwise waits out the kernel's TCP connect timeout, and once a transfer is under
# way only TCPKeepAlive notices a dead peer, after ~2 hours.
SSH_OPTS=(-o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Upload .torrent files from local watch directories to the remote
host's watch directory via scp.

Files modified in the last ${MIN_AGE_SECONDS} seconds are left for the next run.

Options:
  -h, --help    Show this help message and exit
  -q, --quiet   Suppress output
EOF
    exit 0
}

# ANSI escapes only on a terminal: under cron this goes to a log or a mail spool.
# The two streams are tested separately, cron redirecting them independently.
O_BOLD="" O_BLUE="" O_GREEN="" O_OFF="" E_RED="" E_YELLOW="" E_OFF=""
[[ -t 1 ]] && { O_BOLD=$'\033[1m'; O_BLUE=$'\033[1;34m'; O_GREEN=$'\033[1;32m'; O_OFF=$'\033[0m'; }
[[ -t 2 ]] && { E_RED=$'\033[1;31m'; E_YELLOW=$'\033[1;33m'; E_OFF=$'\033[0m'; }

error() { printf ' %s✗%s  %s\n' "${E_RED}" "${E_OFF}" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage ;;
        -q|--quiet) QUIET=true; shift ;;
        # Split a bundled short group (-hq) into -h -q and reprocess; one dash and
        # 2+ characters, so long options never match. Do not rewrite with bash's
        # parameter-length syntax: it opens a Jinja2 comment.
        -[!-]?*)
            mapfile -t bundle < <(fold -w1 <<<"${1#-}")
            shift
            set -- "${bundle[@]/#/-}" "$@"
            ;;
        # No positional arguments, so an unknown flag would be silently ignored.
        -*) error "unknown option: $1" ;;
        *) break ;;
    esac
done

header() { "${QUIET}" || printf '\n%s%s%s\n\n' "${O_BOLD}" "$*" "${O_OFF}"; }
info() { "${QUIET}" || printf ' %s•%s  %s\n' "${O_BLUE}" "${O_OFF}" "$*"; }
# shellcheck disable=SC2120  # ok() is intentionally called with no args (defaults to "OK")
ok() { "${QUIET}" || printf ' %s✔%s  %s\n' "${O_GREEN}" "${O_OFF}" "${*-OK}"; }
# Ungated, unlike the others: the cron job passes --quiet, and gating this would
# leave the final error unexplained in the log.
warn() { printf ' %s!%s  %s\n' "${E_YELLOW}" "${E_OFF}" "$*" >&2; }

# Returns non-zero if any file in the source directory could not be uploaded.
upload_torrent_files() {
    local src="${1}"
    local dst="${2}"
    # Under `set -e` a failing cd would abandon the remaining watch directories.
    [[ -d "${src}" ]] || { info "Skipping ${src}: not a directory"; return 0; }
    # Subshell: whatever happens below, the cd cannot leak back to the caller.
    (
        cd "${src}"
        local rc=0
        local -a scp_opts=("${SSH_OPTS[@]}")
        "${QUIET}" && scp_opts+=(-q)
        for f in *.torrent; do
            [[ -f "${f}" ]] || continue
            if (( $(date +%s) - $(stat -c %Y -- "${f}") < MIN_AGE_SECONDS )); then
                info "Skipping ${f}: modified in the last ${MIN_AGE_SECONDS}s"
                continue
            fi
            info "Copying ${f} to ${dst}"
            # ./ on both: a name beginning with a dash reads as an option, and
            # the glob does not produce one.
            if scp "${scp_opts[@]}" "./${f}" "${dst}"; then
                rm "./${f}" || rc=1
            else
                # Kept, so the next run retries it. Not fatal on its own: the
                # caller reports the failure at the end.
                warn "Failed to copy ${f} to ${dst}"
                rc=1
            fi
        done
        exit "${rc}"
    )
}

header "Uploading .torrent files to remote watch directories"

failed=false
# One lock for the whole run: cron fires every 2 minutes, tighter than a stalled scp, and
# two runs would race to rm the same file. flock releases however the guarded subshell
# ends, including a kill, which a pid check cannot see.
lock_file="${TMPDIR:-/tmp}/mvt-$(id -u).lock"
(
    # A held lock means a prior run is wedged, an upload taking seconds.
    flock -n 9 || error "A previous upload is still running"
    upload_failed=false
    # Derived from each host's own root: a delegated task resolves plain variables from
    # the play host, so torrent_watch_directory would name this host's path for every.
{% for host in ansible_play_batch %}
{% if host != "localhost" %}
{% for watch_dir in torrent_local_watch_directories %}
    upload_torrent_files "{{ watch_dir }}" "{{ host }}:{{ hostvars[host].torrent_root_directory | default(torrent_root_directory) }}/watch/" || upload_failed=true
{% endfor %}
{% endif %}
{% endfor %}
    "${upload_failed}" && exit 1
    exit 0
) 9>"${lock_file}" || failed=true

# Non-zero so cron reports the run, which a per-file warning alone would not.
"${failed}" && error "Some .torrent files could not be uploaded"
ok
