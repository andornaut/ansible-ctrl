#!/bin/bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [DST_DIR]

Rsync completed downloads from the remote torrent host(s) to the
local incoming directory.

Arguments:
  DST_DIR       Local destination directory (default: {{ torrent_local_incoming_directory }})

Options:
  -h, --help    Show this help message and exit
  -q, --quiet   Suppress output
EOF
    exit 0
}

{% include '_preamble.sh.j2' %}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage ;;
        -q|--quiet) QUIET=true; shift ;;
        # Or a typo falls through and is read as the destination directory.
        -*) error "unknown option: $1" ;;
        *) break ;;
    esac
done

dst_dir="${1:-{{ torrent_local_incoming_directory }}}"

if [[ ! -d "${dst_dir}" ]]; then
    error "${dst_dir} does not exist (or is not a directory)"
fi

# --quiet reaches rsync too: --progress emits carriage-returned lines by the
# thousand, and the cron job appends to an unrotated log.
rsync_opts=(--compress --copy-links --recursive --times)
if "${QUIET}"; then
    rsync_opts+=(--quiet)
else
    rsync_opts+=(--human-readable --progress --verbose)
fi

sync_host() {
    local src_host="${1}"
    local src_dir="${2}"
    local remote="${3}"
    local port="${4}"
    # Per host+dir, so a second host still syncs while this one is busy. In the user's
    # home, not /tmp: fs.protected_regular refuses to open a lock file another user
    # created there first. Not XDG_RUNTIME_DIR either, which cron does not set, so a
    # manual run and the cron run would take different locks.
    local lock_dir="${HOME}/.cache"
    local lock_file="${lock_dir}/synct-${src_host}${src_dir//\//_}.lock"
    mkdir -p "${lock_dir}"
    header "Synchronizing files from ${src_host}:${src_dir} to localhost:${dst_dir}"
    # flock releases however the guarded subshell ends, including a kill, which a pid
    # check cannot see. A held lock means a prior sync is wedged, so fail rather than
    # skip: the chained unrart must not see a half-synced directory.
    (
        flock -n 9 || error "A previous sync of ${src_host}:${src_dir} is still running"
        info "Starting sync on $(date)"
        # Tested rather than left to `set -e`, which bash suspends for the whole
        # body of a function called on the left of an ||, as this one is.
        if ! rsync "${rsync_opts[@]}" -e "ssh -p ${port} ${SSH_OPTS[*]}" "${remote}:${src_dir}" "${dst_dir}"; then
            warn "Failed to synchronize ${src_host}:${src_dir}"
            exit 1
        fi
        ok "Completed sync on $(date)"
    ) 9>"${lock_file}"
}

# An unreachable host is no reason to skip the rest. The names go in the message
# because error() ignores the --quiet the cron job passes.
failed_hosts=""
{% for host in groups['torrent'] | default([]) %}
sync_host "{{ host }}" "{{ hostvars[host].torrent_root_directory }}/completed/" "{{ hostvars[host].ansible_user }}@{{ hostvars[host].ansible_host | default(host) }}" "{{ hostvars[host].ansible_port | default(22) }}" || failed_hosts+=" {{ host }}"
{% endfor %}

# Non-zero so cron reports the run, and the chained unrart does not run against a
# half-synced incoming directory.
[[ -z "${failed_hosts}" ]] || error "Could not synchronize:${failed_hosts}"
