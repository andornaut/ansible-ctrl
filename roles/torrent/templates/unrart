#!/bin/bash

set -euo pipefail

COMMAND_PREFIX="nice -n19 ionice -c3"
MAX_DEPTH=5
DELETE_ARCHIVES=false
QUIET=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [DIRECTORY]

Extract archive files (rar, zip, tar.gz, tar.bz2) found in DIRECTORY
(default: {{ torrent_local_incoming_directory }}) up to ${MAX_DEPTH} levels deep.

Options:
  -h, --help             Show this help message and exit
  -q, --quiet            Suppress output
  --delete-archives      Delete archives after extraction
EOF
    exit 0
}

# ANSI escapes only when the stream is a terminal: under cron this output goes to
# a log file or a mail spool, where the codes are noise. Stdout and stderr are
# tested separately because cron redirects them independently.
O_BOLD="" O_BLUE="" O_GREEN="" O_OFF="" E_RED="" E_YELLOW="" E_OFF=""
[[ -t 1 ]] && { O_BOLD=$'\033[1m'; O_BLUE=$'\033[1;34m'; O_GREEN=$'\033[1;32m'; O_OFF=$'\033[0m'; }
[[ -t 2 ]] && { E_RED=$'\033[1;31m'; E_YELLOW=$'\033[1;33m'; E_OFF=$'\033[0m'; }

error() { printf ' %s✗%s  %s\n' "${E_RED}" "${E_OFF}" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --delete-archives)
            DELETE_ARCHIVES=true
            shift
            ;;
        # Split a bundled short group (-hq) into -h -q and reprocess. Matches a
        # single dash followed by 2+ characters, so long options never reach it.
        # Do not rewrite this using bash's parameter-length syntax: that opens a
        # Jinja2 comment, and the template then fails to render.
        -[!-]?*)
            mapfile -t bundle < <(fold -w1 <<<"${1#-}")
            shift
            set -- "${bundle[@]/#/-}" "$@"
            ;;
        # Without this, a typo falls through to the positional branch and is
        # read as the directory to extract in.
        -*)
            error "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

header() { "${QUIET}" || printf '\n%s%s%s\n\n' "${O_BOLD}" "$*" "${O_OFF}"; }
info() { "${QUIET}" || printf ' %s•%s  %s\n' "${O_BLUE}" "${O_OFF}" "$*"; }
ok() { "${QUIET}" || printf ' %s✔%s  %s\n' "${O_GREEN}" "${O_OFF}" "${*-OK}"; }
warn() { "${QUIET}" || printf ' %s!%s  %s\n' "${E_YELLOW}" "${E_OFF}" "$*" >&2; }

# The extractors write their own output to fd 3. Do not point them at a
# /dev/stdout path instead: `>` opens it with O_TRUNC, so `unrart >> log` would
# empty the log on every archive.
exec 3>&1
if "${QUIET}"; then
    exec 3>/dev/null
fi

trap 'exit' INT

directory="${1:-{{ torrent_local_incoming_directory }}}"
[[ -d "${directory}" ]] || error "${directory} does not exist (or is not a directory)"
# Extraction runs from each archive's own directory, so anchor the search at an
# absolute path: a relative one would not resolve after that cd.
directory="$(cd "${directory}" && pwd)"

# RAR sets are split across volumes (name.rar + name.r00, name.r01, ... or
# name.part1.rar, name.part2.rar, ...), so deleting the extracted archive alone
# leaves the rest behind. Match the set by comparing its stem as a literal
# string: release names routinely contain '.' and '[', which find's -iregex and
# -name would interpret.
delete_rar_volumes() {
    local archive_dir="${1}"
    local archive="${2}"
    local stem="${archive##*/}"
    stem="${stem%.*}"
    stem="${stem%.[Pp][Aa][Rr][Tt][0-9]*}"
    local f base
    for f in "${archive_dir}"/*; do
        [[ -f "${f}" ]] || continue
        base="${f##*/}"
        [[ "${base}" == "${stem}".* ]] || continue
        case "${base##*.}" in
            [Rr][Aa][Rr]|[Rr][0-9][0-9]) rm -f "${f}" ;;
        esac
    done
}

extract() {
    local archive="$1"
    local archive_dir
    archive_dir="$(dirname "${archive}")"

    info "${archive}"
    # The extractors unpack into the current directory, so run in a subshell:
    # whatever happens below, the cd cannot leak back to the caller.
    (
        cd "${archive_dir}"
        local rc=0
        case "${archive,,}" in
            *.rar)             ${COMMAND_PREFIX} unrar e -o- -y "${archive}" >&3 || rc=$? ;;
            *.tar.gz|*.tgz)    ${COMMAND_PREFIX} tar xzf "${archive}" >&3 || rc=$? ;;
            *.tar.bz2|*.tbz2)  ${COMMAND_PREFIX} tar xjf "${archive}" >&3 || rc=$? ;;
            *.zip)             ${COMMAND_PREFIX} unzip -n "${archive}" >&3 || rc=$? ;;
        esac

        # unrar returns 10 for minor warnings (e.g. file already exists with -o-)
        if [[ "${rc}" -ne 0 && ("${archive,,}" != *.rar || "${rc}" -ne 10) ]]; then
            error "Failed to extract ${archive} (exit code: ${rc})"
        fi

        if "${DELETE_ARCHIVES}"; then
            case "${archive,,}" in
                *.rar) delete_rar_volumes "${archive_dir}" "${archive}" ;;
                *)     rm -f "${archive}" ;;
            esac
        fi
    )
}

header "Extracting archives in ${directory} (max depth: ${MAX_DEPTH})"

# Collect the list before extracting anything: find streams its results, so an
# archive unpacked into a directory it has not yet reached would otherwise join
# the same pass. -print0 keeps a name containing a newline in one piece.
archives=()
mapfile -d '' -t archives < <(
    find "${directory}" -maxdepth "${MAX_DEPTH}" \
        -iregex '.*\.\(rar\|zip\|tar\.gz\|tgz\|tar\.bz2\|tbz2\)' -print0
)

count=0
for archive in "${archives[@]}"; do
    extract "${archive}"
    count=$((count + 1))
done

if [[ "${count}" -eq 0 ]]; then
    warn "No archives found"
else
    ok "Extracted ${count} archive(s)"
fi
