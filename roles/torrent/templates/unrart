#!/bin/bash

set -euo pipefail

COMMAND_PREFIX="nice -n19 ionice -c3"
MAX_DEPTH=5
DELETE_ARCHIVES=false
QUIET=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [DIRECTORY]

Extract archive files (rar, zip, tar.gz, tar.bz2) found in DIRECTORY
(default: {{ torrent_local_incoming_directory }}) up to ${MAX_DEPTH} levels deep.
Dot-directories are skipped: they hold quarantined content that must stay packed.

Options:
  -h, --help             Show this help message and exit
  -q, --quiet            Suppress output
  --delete-archives      Delete archives after extraction
EOF
    exit 0
}

# ANSI escapes only when the stream is a terminal: under cron this output goes to
# a log file or a mail spool, where the codes are noise. Stdout and stderr are
# tested separately because cron redirects them independently.
O_BOLD="" O_BLUE="" O_GREEN="" O_OFF="" E_RED="" E_YELLOW="" E_OFF=""
[[ -t 1 ]] && { O_BOLD=$'\033[1m'; O_BLUE=$'\033[1;34m'; O_GREEN=$'\033[1;32m'; O_OFF=$'\033[0m'; }
[[ -t 2 ]] && { E_RED=$'\033[1;31m'; E_YELLOW=$'\033[1;33m'; E_OFF=$'\033[0m'; }

error() { printf ' %s✗%s  %s\n' "${E_RED}" "${E_OFF}" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --delete-archives)
            DELETE_ARCHIVES=true
            shift
            ;;
        # Split a bundled short group (-hq) into -h -q and reprocess. Matches a
        # single dash followed by 2+ characters, so long options never reach it.
        # Do not rewrite this using bash's parameter-length syntax: that opens a
        # Jinja2 comment, and the template then fails to render.
        -[!-]?*)
            mapfile -t bundle < <(fold -w1 <<<"${1#-}")
            shift
            set -- "${bundle[@]/#/-}" "$@"
            ;;
        # Without this, a typo falls through to the positional branch and is
        # read as the directory to extract in.
        -*)
            error "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

header() { "${QUIET}" || printf '\n%s%s%s\n\n' "${O_BOLD}" "$*" "${O_OFF}"; }
info() { "${QUIET}" || printf ' %s•%s  %s\n' "${O_BLUE}" "${O_OFF}" "$*"; }
ok() { "${QUIET}" || printf ' %s✔%s  %s\n' "${O_GREEN}" "${O_OFF}" "${*-OK}"; }
# Not gated on --quiet, unlike the others: a warning names the archive that failed,
# and the cron job passes --quiet, so gating it leaves the final error unexplained.
warn() { printf ' %s!%s  %s\n' "${E_YELLOW}" "${E_OFF}" "$*" >&2; }

# The extractors write their own output to fd 3. Do not point them at a
# /dev/stdout path instead: `>` opens it with O_TRUNC, so `unrart >> log` would
# empty the log on every archive.
exec 3>&1
if "${QUIET}"; then
    exec 3>/dev/null
fi

trap 'exit' INT

directory="${1:-{{ torrent_local_incoming_directory }}}"
[[ -d "${directory}" ]] || error "${directory} does not exist (or is not a directory)"
# Extraction runs from each archive's own directory, so anchor the search at an
# absolute path: a relative one would not resolve after that cd.
directory="$(cd "${directory}" && pwd)"

# RAR sets are split across volumes (name.rar + name.r00, name.r01, ... or
# name.part1.rar, name.part2.rar, ...), so deleting the extracted archive alone
# leaves the rest behind. Match the set by comparing its stem as a literal
# string: release names routinely contain '.' and '[', which find's -iregex and
# -name would interpret.
delete_rar_volumes() {
    local archive_dir="${1}"
    local archive="${2}"
    local stem="${archive##*/}"
    stem="${stem%.*}"
    stem="${stem%.[Pp][Aa][Rr][Tt][0-9]*}"
    local f base
    for f in "${archive_dir}"/*; do
        [[ -f "${f}" ]] || continue
        base="${f##*/}"
        [[ "${base}" == "${stem}".* ]] || continue
        case "${base##*.}" in
            [Rr][Aa][Rr]|[Rr][0-9][0-9]) rm -f "${f}" ;;
        esac
    done
}

# unrar follows a multi-volume set from its first volume, so the later parts are
# not separate archives. Old-style .r00/.r01 volumes do not match the find
# expression below, but every part of a .partN.rar set does. part1, part01 and
# part001 are all first volumes; part2 and part10 are not.
is_later_rar_volume() {
    local name="${1,,}"
    # Compare the number, not its spelling. 10# because a leading zero would
    # otherwise be read as octal, making part08 an error rather than volume 8.
    [[ "${name}" =~ \.part([0-9]+)\.rar$ ]] || return 1
    (( 10#${BASH_REMATCH[1]} != 1 ))
}

# Returns non-zero if the archive could not be extracted.
extract() {
    local archive="$1"
    local archive_dir
    archive_dir="$(dirname "${archive}")"

    info "${archive}"
    # The extractors unpack into the current directory, so run in a subshell:
    # whatever happens below, the cd cannot leak back to the caller.
    (
        # Test the cd rather than leaving it to `set -e`: the caller invokes this
        # function in an if, and bash suspends `set -e` for the whole body of a
        # function called that way, so a failed cd would unpack into the wrong
        # directory instead of aborting.
        cd "${archive_dir}" || exit 1
        local rc=0
        case "${archive,,}" in
            *.rar)             ${COMMAND_PREFIX} unrar e -o- -y "${archive}" >&3 || rc=$? ;;
            *.tar.gz|*.tgz)    ${COMMAND_PREFIX} tar xzf "${archive}" >&3 || rc=$? ;;
            *.tar.bz2|*.tbz2)  ${COMMAND_PREFIX} tar xjf "${archive}" >&3 || rc=$? ;;
            *.zip)             ${COMMAND_PREFIX} unzip -n "${archive}" >&3 || rc=$? ;;
        esac

        # unrar returns 10 for minor warnings (e.g. file already exists with -o-)
        if [[ "${rc}" -ne 0 && ("${archive,,}" != *.rar || "${rc}" -ne 10) ]]; then
            # Not fatal: nothing removes a corrupt or truncated archive from the
            # incoming directory, so aborting here would block every archive
            # sorting after it, on this run and on every run after it.
            warn "Failed to extract ${archive} (exit code: ${rc})"
            exit 1
        fi

        if "${DELETE_ARCHIVES}"; then
            case "${archive,,}" in
                *.rar) delete_rar_volumes "${archive_dir}" "${archive}" ;;
                *)     rm -f "${archive}" ;;
            esac
        fi
    )
}

header "Extracting archives in ${directory} (max depth: ${MAX_DEPTH})"

# Collect the list before extracting anything: find streams its results, so an
# archive unpacked into a directory it has not yet reached would otherwise join
# the same pass. -print0 keeps a name containing a newline in one piece.
# -type f: a directory named like an archive otherwise reaches the extractors, and
# --delete-archives would then rm -f a directory and fail.
# Dot-directories are pruned: a download never lands in one, and the media
# libraries use them for content that must stay packed. Unpacking an archive
# quarantined in incoming/.uncategorized/ leaves its contents loose beside it,
# and for an arcade romset that means scattering chip dumps out of the TorrentZip
# they are checksummed in. The prune must come before -type f, since a directory
# is not a regular file and would otherwise never be tested. -mindepth 1 keeps the
# prune off the start point, which find tests against the same expression: without
# it, passing a dot-directory as DIRECTORY prunes the target and reports nothing.
archives=()
mapfile -d '' -t archives < <(
    find "${directory}" -mindepth 1 -maxdepth "${MAX_DEPTH}" \
        -name '.*' -type d -prune -o \
        -type f -iregex '.*\.\(rar\|zip\|tar\.gz\|tgz\|tar\.bz2\|tbz2\)' -print0
)

count=0
failed=false
for archive in "${archives[@]}"; do
    if is_later_rar_volume "${archive}"; then
        info "Skipping ${archive}: not the first volume of its set"
        continue
    fi
    if extract "${archive}"; then
        count=$((count + 1))
    else
        failed=true
    fi
done

if "${failed}"; then
    # Exit non-zero so cron reports the run. The per-archive warnings above name
    # which ones, and the rest of the batch has already been extracted.
    error "Some archives could not be extracted"
elif [[ "${count}" -eq 0 ]]; then
    # Not a warning: most completed downloads contain no archive at all, and this
    # runs every 2 minutes against an unrotated log.
    info "No archives found"
else
    ok "Extracted ${count} archive(s)"
fi
