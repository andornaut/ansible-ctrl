#!/bin/bash

set -euo pipefail

COMMAND_PREFIX="nice -n19 ionice -c3"
MAX_DEPTH=5
DELETE_ARCHIVES=false
QUIET=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [DIRECTORY]

Extract archive files (rar, zip, tar.gz, tar.bz2) found in DIRECTORY
(default: {{ torrent_local_incoming_directory }}) up to ${MAX_DEPTH} levels deep.
Dot-directories are skipped: they hold quarantined content that must stay packed.

Options:
  -h, --help             Show this help message and exit
  -q, --quiet            Suppress output
  --delete-archives      Delete archives after extraction
EOF
    exit 0
}

# ANSI escapes only on a terminal: under cron this goes to a log or a mail spool.
# The two streams are tested separately, cron redirecting them independently.
O_BOLD="" O_BLUE="" O_GREEN="" O_OFF="" E_RED="" E_YELLOW="" E_OFF=""
[[ -t 1 ]] && { O_BOLD=$'\033[1m'; O_BLUE=$'\033[1;34m'; O_GREEN=$'\033[1;32m'; O_OFF=$'\033[0m'; }
[[ -t 2 ]] && { E_RED=$'\033[1;31m'; E_YELLOW=$'\033[1;33m'; E_OFF=$'\033[0m'; }

error() { printf ' %s✗%s  %s\n' "${E_RED}" "${E_OFF}" "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --delete-archives)
            DELETE_ARCHIVES=true
            shift
            ;;
        # Split a bundled short group (-hq) into -h -q and reprocess; one dash
        # and 2+ characters, so long options never match. Do not rewrite with
        # bash's parameter-length syntax: it opens a Jinja2 comment.
        -[!-]?*)
            mapfile -t bundle < <(fold -w1 <<<"${1#-}")
            shift
            set -- "${bundle[@]/#/-}" "$@"
            ;;
        # Or a typo falls through and is read as the directory to extract in.
        -*)
            error "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

header() { "${QUIET}" || printf '\n%s%s%s\n\n' "${O_BOLD}" "$*" "${O_OFF}"; }
info() { "${QUIET}" || printf ' %s•%s  %s\n' "${O_BLUE}" "${O_OFF}" "$*"; }
ok() { "${QUIET}" || printf ' %s✔%s  %s\n' "${O_GREEN}" "${O_OFF}" "${*-OK}"; }
# Ungated, unlike the others: the cron job passes --quiet, and gating this would
# leave the final error unexplained.
warn() { printf ' %s!%s  %s\n' "${E_YELLOW}" "${E_OFF}" "$*" >&2; }

# The extractors write to fd 3. Not a /dev/stdout path: `>` opens that O_TRUNC, so
# `unrart >> log` would empty the log on every archive.
exec 3>&1
if "${QUIET}"; then
    exec 3>/dev/null
fi

trap 'exit' INT

directory="${1:-{{ torrent_local_incoming_directory }}}"
[[ -d "${directory}" ]] || error "${directory} does not exist (or is not a directory)"
# Extraction runs from each archive's own directory, so a relative search path
# would not resolve after the cd.
directory="$(cd "${directory}" && pwd)"

# A RAR set spans volumes, so deleting the extracted archive alone leaves the rest.
# The stem is compared as a literal string: release names routinely contain '.'
# and '[', which find's -iregex and -name would interpret.
delete_rar_volumes() {
    local archive_dir="${1}"
    local archive="${2}"
    local stem="${archive##*/}"
    stem="${stem%.*}"
    stem="${stem%.[Pp][Aa][Rr][Tt][0-9]*}"
    local f base
    for f in "${archive_dir}"/*; do
        [[ -f "${f}" ]] || continue
        base="${f##*/}"
        [[ "${base}" == "${stem}".* ]] || continue
        case "${base##*.}" in
            [Rr][Aa][Rr]|[Rr][0-9][0-9]) rm -f "${f}" ;;
        esac
    done
}

# unrar follows a set from its first volume, so later parts are not separate
# archives. Old-style .r00 volumes miss the find below, but every .partN.rar
# matches: part1, part01 and part001 are first volumes, part2 and part10 are not.
is_later_rar_volume() {
    local name="${1,,}"
    # The number, not its spelling. 10#, or a leading zero reads as octal and
    # part08 is an error rather than volume 8.
    [[ "${name}" =~ \.part([0-9]+)\.rar$ ]] || return 1
    (( 10#${BASH_REMATCH[1]} != 1 ))
}

# Returns non-zero if the archive could not be extracted.
extract() {
    local archive="$1"
    local archive_dir
    archive_dir="$(dirname "${archive}")"

    info "${archive}"
    # The extractors unpack into the current directory; the subshell keeps the cd
    # from leaking back to the caller.
    (
        # Tested rather than left to `set -e`, which bash suspends for the whole
        # body of a function called in an if, as this one is.
        cd "${archive_dir}" || exit 1
        local rc=0
        case "${archive,,}" in
            *.rar)             ${COMMAND_PREFIX} unrar e -o- -y "${archive}" >&3 || rc=$? ;;
            *.tar.gz|*.tgz)    ${COMMAND_PREFIX} tar xzf "${archive}" >&3 || rc=$? ;;
            *.tar.bz2|*.tbz2)  ${COMMAND_PREFIX} tar xjf "${archive}" >&3 || rc=$? ;;
            *.zip)             ${COMMAND_PREFIX} unzip -n "${archive}" >&3 || rc=$? ;;
        esac

        # unrar returns 10 for minor warnings (e.g. file already exists with -o-)
        if [[ "${rc}" -ne 0 && ("${archive,,}" != *.rar || "${rc}" -ne 10) ]]; then
            # Not fatal: nothing removes a corrupt archive from the incoming
            # directory, so aborting would block every archive after it, forever.
            warn "Failed to extract ${archive} (exit code: ${rc})"
            exit 1
        fi

        if "${DELETE_ARCHIVES}"; then
            case "${archive,,}" in
                *.rar) delete_rar_volumes "${archive_dir}" "${archive}" ;;
                *)     rm -f "${archive}" ;;
            esac
        fi
    )
}

header "Extracting archives in ${directory} (max depth: ${MAX_DEPTH})"

# Collected before extracting anything: find streams its results, so an archive
# unpacked into a directory it has not reached would join the same pass. -print0
# keeps a name containing a newline whole, and -type f keeps a directory named
# like an archive away from the extractors and from --delete-archives.
#
# Dot-directories are pruned: the media libraries use them for content that must
# stay packed, and unpacking a quarantined arcade romset would scatter chip dumps
# out of the TorrentZip they are checksummed in. The prune comes before -type f, a
# directory not being a regular file, and -mindepth 1 keeps it off the start point.
archives=()
mapfile -d '' -t archives < <(
    find "${directory}" -mindepth 1 -maxdepth "${MAX_DEPTH}" \
        -name '.*' -type d -prune -o \
        -type f -iregex '.*\.\(rar\|zip\|tar\.gz\|tgz\|tar\.bz2\|tbz2\)' -print0
)

count=0
failed=false
for archive in "${archives[@]}"; do
    if is_later_rar_volume "${archive}"; then
        info "Skipping ${archive}: not the first volume of its set"
        continue
    fi
    if extract "${archive}"; then
        count=$((count + 1))
    else
        failed=true
    fi
done

if "${failed}"; then
    # Non-zero so cron reports the run; the warnings above name which archives.
    error "Some archives could not be extracted"
elif [[ "${count}" -eq 0 ]]; then
    # Not a warning: most downloads contain no archive, and this runs every 2
    # minutes against an unrotated log.
    info "No archives found"
else
    ok "Extracted ${count} archive(s)"
fi
