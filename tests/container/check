#!/usr/bin/env bash
set -euo pipefail
cd /work
export ANSIBLE_CONFIG=/work/ansible.cfg
export USER=lint LOGNAME=lint
python3 -m venv /scratch/venv
/scratch/venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.txt
cp requirements-dev.txt /scratch/venv/requirements-dev.txt
export PATH="/scratch/venv/bin:${PATH}"
mkdir -p .ansible /scratch/collections
ln -s /scratch/venv .ansible/lint-venv
ln -s /scratch/collections .ansible/collections
ansible-galaxy collection install -r requirements.yml -p /scratch/collections
git init --quiet
for phase in "$@"; do tests/lint.sh "${phase}"; done
