#!/usr/bin/env bash
set -euo pipefail
if [[ ${PWD} != /work || $(id -u) != 19001 || ! ${CHECK_SOURCE_SHA256:-} =~ ^[a-f0-9]{64}$ ]]; then
    printf '%s\n' 'Native check bootstrap requires an isolated source snapshot.' >&2
    exit 2
fi
export ANSIBLE_CONFIG=/work/ansible.cfg
export USER=lint LOGNAME=lint
export PATH="/scratch/venv/bin:${PATH}"
git init --quiet
printf '/node_modules\n' >>.git/info/exclude
mkdir -p .ansible
ln -s /scratch/venv .ansible/lint-venv
ln -s /scratch/collections .ansible/collections
exec "$@"
