#!/usr/bin/env bash
set -euo pipefail
checkout=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
# shellcheck source=tests/container/stock
source "${checkout}/tests/container/stock"
action=${1:-check}
case "${action}" in
    check|lint) phases=(ansible-lint config shell python) ;;
    test) phases=(identity dispatch) ;;
    markdown) phases=() ;;
    ansible-lint|config|shell|python|identity|dispatch) phases=("${action}") ;;
    *) printf 'Unknown check: %s\n' "${action}" >&2; exit 2 ;;
esac
if [[ ${action} == check ]]; then phases+=(identity dispatch); fi
stock_begin "${checkout}"
if (( ${#phases[@]} )); then
    STOCK_NETWORK=bridge stock_run "${PYTHON_IMAGE:-python:$(<"${checkout}/.python-version")}" -- tests/container/check "${phases[@]}"
fi
if [[ ${action} == check || ${action} == lint || ${action} == markdown ]]; then
    node_version=$(<"${checkout}/.nvmrc")
    STOCK_NETWORK=bridge stock_run "${MARKDOWN_IMAGE:-node:${node_version#v}}" -- tests/container/markdown
fi
stock_finish
